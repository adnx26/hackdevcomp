# Example gateway configuration. Copy outside the repository; never commit real values.
# Secrets are referenced by file path so they are injected by the host, not stored here.

# Private runtime state (scratch, pid records). Must NOT be under the system temp directory.
PG_STATE_DIR=/var/lib/protection-gateway/runtime

# Worker sandbox: "seatbelt" (macOS default) or "shadi" (shadictl). Activation probes decide
# whether the chosen backend is accepted; there is no unsandboxed mode.
PG_SANDBOX_BACKEND=seatbelt
# PG_SHADICTL=/usr/local/bin/shadictl

# Approved model processor. Leave PG_MODEL_PROVIDER unset to keep model-based inspection disabled.
PG_MODEL_PROVIDER=anthropic
PG_MODEL=claude-opus-5-5
PG_MODEL_API_KEY_FILE=/run/secrets/pg-model-api-key
PG_MODEL_MAX_OUTPUT_TOKENS=4096
PG_JOB_TOKEN_BUDGET=200000
PG_JOB_CALL_BUDGET=16

# Collector signing key (32+ random bytes). Unset = a fresh key per gateway process.
PG_COLLECTOR_KEY_FILE=/run/secrets/pg-collector-key

# Exact external origins accepted by the UI/MCP/chat adapters (comma-separated). Empty = adapters unavailable.
PG_ALLOWED_ORIGINS=https://gateway.example

# Public listener. Anything other than loopback requires both TLS files.
PG_HOST=127.0.0.1
PG_PORT=8443
# PG_TLS_CERT=/run/secrets/pg-tls.crt
# PG_TLS_KEY=/run/secrets/pg-tls.key
